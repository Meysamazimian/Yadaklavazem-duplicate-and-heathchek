PORT=3100

# ---- Source database (the main shop DB). Only SELECT/SHOW is ever run on it: use a read-only MySQL user. ----
SRC_DB_HOST=127.0.0.1
SRC_DB_PORT=3306
SRC_DB_USER=
SRC_DB_PASSWORD=
SRC_DB_NAME=yadak_saas

# ---- Replica database (must be a DIFFERENT database; the app refuses to start if it equals the source) ----
# Host/port/user/password fall back to the SRC_* values when empty.
DST_DB_HOST=
DST_DB_PORT=
DST_DB_USER=
DST_DB_PASSWORD=
DST_DB_NAME=yadak_saas_replica

# ---- Dashboard ----
DASHBOARD_PASSWORD=change_me_to_a_long_password
# Signs the login cookie. Optional: derived from the password when empty.
SESSION_SECRET=
# true when the dashboard is served over https (adds the Secure flag to the cookie)
COOKIE_SECURE=true
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- Schedule ----
# One cycle = replicate + health-check. The in-process scheduler runs it every N minutes.
CYCLE_INTERVAL_MINUTES=5
# Disable the in-process timer when only the cron hit should drive cycles
ENABLE_SCHEDULER=true
# Secret for GET /cron/run?key=...  (leave empty to disable the endpoint)
CRON_KEY=

# ---- Replication ----
REPLICATE_BATCH_SIZE=500
# Stop starting new tables after this many seconds; the rest continues next cycle
REPLICATE_MAX_SECONDS=240
# Comma separated table names to skip / to copy exclusively (empty include = all)
REPLICATE_EXCLUDE=cache,knex_migrations_lock
REPLICATE_INCLUDE=
# Re-read this many ids below the stored watermark to catch rows that committed out of order (INSERT IGNORE makes it safe)
REPLICATE_LOOKBACK=1000
# Tables without an integer primary key are re-scanned fully each cycle, up to this many rows
FULL_SCAN_MAX_ROWS=500000
# COUNT(*) both sides after each table to show the lag (set false for very large tables)
REPLICATE_COUNT_ROWS=true

# ---- Health check ----
# The backend base URL as seen from this server
BACKEND_URL=http://127.0.0.1:3000
# Same value as the Backend INTERNAL_PROXY_TOKEN (sent as X-Internal-Token)
INTERNAL_PROXY_TOKEN=
# Any shop host (sent as X-Forwarded-Host) so shop routes get past tenant detection
MONITOR_SHOP_HOST=
# Where the Backend serves its OpenAPI specs (the Backend SWAGGER_PATH default)
BACKEND_SWAGGER_PATH=/api/internal/swagger-docs
# Skip discovered paths matching this regex (they are GET-only; these can have side effects or lockouts)
MONITOR_EXCLUDE=/api/bot/|/api/payment/|/logout|/swagger
# Optional JSON file with extra / overriding endpoints (see README)
ENDPOINTS_FILE=
REQUEST_TIMEOUT_MS=10000
MONITOR_CONCURRENCY=5
# An endpoint is reported down (event) after this many failed checks in a row
FAIL_THRESHOLD=2
# Re-read the Backend OpenAPI specs at most this often
DISCOVERY_REFRESH_MINUTES=60

# ---- Retention of monitoring history (the replicated data itself is never deleted) ----
RETENTION_DAYS=14
